# ===== Conexión =====
# Usa un RPC privado (Helius, Triton, QuickNode...). Los públicos son lentos y limitan peticiones.
RPC_URL=https://api.mainnet-beta.solana.com
WS_URL=wss://api.mainnet-beta.solana.com

# ===== Detección =====
#   websocket = logsSubscribe + getParsedTransaction. Funciona con cualquier RPC. El más lento.
#   grpc      = Yellowstone gRPC: txs ejecutadas (processed) sin pedir nada al RPC. Mucho más rápido.
#   shreds    = Yellowstone deshred: txs ANTES de ejecutarse. Lo más rápido; la tx detectada aún puede fallar.
DETECTION=websocket
# Endpoint y token de Yellowstone (Helius, Triton, Shyft, QuickNode...). Obligatorio con grpc/shreds.
GRPC_URL=
GRPC_TOKEN=

# ===== Wallet =====
# Clave privada en base58 o como array JSON [1,2,3,...]. Usa una wallet DEDICADA solo al bot.
PRIVATE_KEY=

# ===== Modo =====
# true = paper trading (quotes reales, no envía transacciones). Cámbialo a false solo cuando estés seguro.
DRY_RUN=true

# ===== Fuentes a vigilar =====
# Separadas por coma:
#   stonkfun  = lanzamientos de StonkFun (Raydium LaunchLab con platform_config de StonkFun)
#   launchlab = cualquier lanzamiento de LaunchLab (StonkFun, Bonk y demás plataformas)
#   pumpfun   = tokens nuevos de pump.fun
#   raydium   = pools nuevos de Raydium AMM v4
SOURCES=stonkfun
# platform_config de StonkFun (por defecto: reward + estándar). Solo cámbialo si StonkFun crea uno nuevo.
# STONKFUN_PLATFORM_CONFIGS=6BwHHDg3u1854jC8PDLXvR4spTcLNaoBxLJNGC4nTESt,4E876qZTE9FJMrBzgVtBrSrzz2TLivB5Y5QXPjB4gZL7

# ===== Compra =====
# Con importes muy pequeños las comisiones fijas se comen el beneficio (el bot avisa al arrancar si pasan del 5 %).
BUY_AMOUNT_SOL=0.05
# StonkFun empareja contra SPYx, NVDAx, etc. Por defecto se gasta el equivalente de BUY_AMOUNT_SOL
# (convertido con Jupiter). Para fijar un importe por quote token: MINT=cantidad,MINT2=cantidad
# QUOTE_BUY_AMOUNTS=
# Si no hay saldo del quote token, comprarlo automáticamente con SOL (añade una tx y latencia).
# Lo ideal es tener ya saldo de los quote tokens en la wallet.
AUTO_SWAP_QUOTE=false
SLIPPAGE_BPS=1500
# Comisión de prioridad máxima por transacción (en lamports; 1 SOL = 1e9 lamports)
PRIORITY_FEE_MAX_LAMPORTS=200000
COMPUTE_UNIT_LIMIT=250000
# Máximo de posiciones abiertas a la vez. La wallet de referencia opera ~80 tokens/día con 1 día de tenencia:
# muchas posiciones pequeñas a la vez. Capital necesario ≈ MAX_OPEN_POSITIONS × BUY_AMOUNT_SOL.
MAX_OPEN_POSITIONS=20

# ===== Filtros de seguridad =====
REQUIRE_MINT_AUTHORITY_REVOKED=true
REQUIRE_FREEZE_AUTHORITY_REVOKED=true
# Exige que exista ruta de venta en Jupiter antes de comprar (anti-honeypot básico)
REQUIRE_SELL_ROUTE=true
# Comisión de transferencia Token-2022 máxima aceptada (bps). La config "reward" de StonkFun usa 100–300.
MAX_TRANSFER_FEE_BPS=300
# No compra si la curva ya está más llena que este % (dev buy grande o llegamos tarde)
MAX_CURVE_PROGRESS_PCT=20
# Market cap máximo en USD al comprar (0 = sin límite). La wallet de referencia compra el 88 % por debajo de 100K.
MAX_ENTRY_MCAP_USD=100000

# ===== Salida =====
# Las posiciones en la curva de StonkFun se evalúan en cada cambio del pool (suscripción en tiempo real);
# además se revisan todas cada PRICE_CHECK_INTERVAL_MS. Ojo: en un rug pull el precio cae de golpe y el
# stop-loss vende al precio que haya, no al del límite.
STOP_LOSS_PCT=30
# Trailing stop: una vez el PnL máximo supera TRAILING_ACTIVATION_PCT, vende si cae TRAILING_STOP_PCT desde el máximo (0 = off)
TRAILING_STOP_PCT=25
TRAILING_ACTIVATION_PCT=50
# Venta parcial: al llegar a +PARTIAL_TP_PCT vende el PARTIAL_TP_SELL_PCT % (recupera la inversión) (0 = off)
PARTIAL_TP_PCT=100
PARTIAL_TP_SELL_PCT=50
# Take-profit total del resto
TAKE_PROFIT_PCT=300
# Vende pase lo que pase tras N segundos (0 = desactivado)
MAX_HOLD_SECONDS=86400
PRICE_CHECK_INTERVAL_MS=2000

# ===== Límites de riesgo =====
# Deja de comprar al perder esto en el día (UTC) (0 = sin límite)
MAX_DAILY_LOSS_SOL=0.25
# Tras N operaciones perdedoras seguidas, pausa de COOLDOWN_MINUTES sin comprar (0 = sin límite)
MAX_CONSECUTIVE_LOSSES=5
COOLDOWN_MINUTES=60
RISK_FILE=risk.json
# Las posiciones abiertas se guardan aquí y se retoman al reiniciar el bot
POSITIONS_FILE=positions.json
# Cada token cerrado se guarda aquí (abrible en Excel/Sheets). El bot muestra cada STATS_SUMMARY_MINUTES un
# resumen con los mismos tramos que GMGN (tasa de éxito, >500%, 200~500%, 0~200%, -50~0%, <-50%) para comparar.
STATS_FILE=trades.csv
STATS_SUMMARY_MINUTES=60

# ===== Jito =====
# Envía nuestras txs de LaunchLab también al block engine de Jito con una propina (más probabilidad
# de entrar en el primer bloque). Las txs de Jupiter se envían solo por RPC.
JITO_ENABLED=false
JITO_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=50000

# ===== Jupiter =====
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
# Opcional: clave de api.jup.ag (si la usas, cambia también JUPITER_API_URL a https://api.jup.ag/swap/v1)
JUPITER_API_KEY=
